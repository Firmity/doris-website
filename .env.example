# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed — it holds live credentials.

# ---------------------------------------------------------------------------
# Google Sheets (primary — every enquiry form submission lands here)
# ---------------------------------------------------------------------------
# Used instead of Gmail SMTP because this Gmail account can't generate App
# Passwords (App Passwords page shows "not available for your account" even
# with 2-Step Verification on — a Google account-level restriction, not
# something fixable from this codebase). A Sheets-writing Google Cloud
# service account sidesteps that entirely: no 2FA/app-password dance, no
# personal-account send limits, and it's the standard way a serverless app
# talks to Google APIs non-interactively.
#
# One-time setup (~5 minutes):
# 1. Go to https://console.cloud.google.com — create a project (or reuse one).
# 2. APIs & Services > Library — search "Google Sheets API" — click Enable.
# 3. APIs & Services > Credentials > Create Credentials > Service Account.
#    Give it any name (e.g. "doris-sheets-writer"), no roles needed, Done.
# 4. Click into the new service account > Keys tab > Add Key > Create new key
#    > JSON. This downloads a .json file — open it, you need two fields from
#    it: `client_email` and `private_key`.
# 5. Create (or open) the destination Google Sheet. Add a tab named exactly
#    `Enquiries` (case-sensitive) — this is where rows get appended.
#    Optional header row: Timestamp | Name | Email | Dates | Message.
# 6. Click Share on the sheet, paste in the service account's `client_email`
#    (looks like `...@...iam.gserviceaccount.com`), give it Editor access.
#    Service accounts have zero access of their own — only what's shared.
# 7. Copy the sheet's ID from its URL:
#    https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit

GOOGLE_SERVICE_ACCOUNT_EMAIL=doris-sheets-writer@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON exactly as-is,
# including the literal \n sequences and the BEGIN/END PRIVATE KEY lines —
# do not manually insert real line breaks. Wrap the whole thing in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1a2B3cD4EfGhIjKlMnOpQrStUvWxYz

# ---------------------------------------------------------------------------
# Gmail SMTP (optional — guest confirmation email only, best-effort)
# ---------------------------------------------------------------------------
# The enquiry form works fully without this — Google Sheets above is the
# critical path. If left unset, the app just skips sending the guest a
# confirmation email (logs "[SMTP_SKIP]", nothing breaks).
#
# EMAIL_USER: the Gmail address that logs in to SMTP.
# EMAIL_APP_PASSWORD: a 16-character Gmail "App Password" — NOT the regular
# Gmail login password. Requires 2-Step Verification to be on. Generate one
# at https://myaccount.google.com/apppasswords. If that page is unavailable
# even with 2-Step Verification on, this account can't use SMTP at all —
# leave these two unset and rely on Sheets only.
EMAIL_USER=dorismbhotel@gmail.com
EMAIL_APP_PASSWORD=
