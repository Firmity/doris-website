# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed — it holds a live credential.
#
# EMAIL_USER: the Gmail address that logs in to SMTP and sends both the
# hotel-notification and guest-confirmation emails (dorismbhotel@gmail.com
# sends to itself, per how this project is configured).
#
# EMAIL_APP_PASSWORD: a 16-character Gmail "App Password" for that account —
# NOT the regular Gmail login password. Requires 2-Step Verification to be
# turned on for the account first. Generate one at:
#   https://myaccount.google.com/apppasswords
# (If that page says App Passwords aren't available, turn on 2-Step
# Verification at https://myaccount.google.com/security first, then retry.)
EMAIL_USER=dorismbhotel@gmail.com
EMAIL_APP_PASSWORD=Doris@0101
